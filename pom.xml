<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>saucedemo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <suiteXmlFile>src/test/resources/regression.xml</suiteXmlFile>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <aspectjweaver.version>1.9.6</aspectjweaver.version>
        <testng.version>7.4.0</testng.version>
        <selenium.version>4.1.1</selenium.version>
        <webdriver.version>6.3.4</webdriver.version>
        <allure-testng.version>2.13.9</allure-testng.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <!-- нужен для возвожности запуска тестов по правилам из regression.xml через maven-команды в командной строке или Его задача — запускать тесты во время Maven-фазы: -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M3</version>
                <configuration>
             <!--       У Surefire также есть:
                    <argLine>
                        -javaagent:...aspectjweaver...jar -Xmx256m
                    </argLine>
                    argLine позволяет передать параметры JVM, в которой будут выполняться тесты.
                    Здесь передаётся два параметра.
                    Первый:
                    -javaagent:...aspectjweaver...jar
                    подключает AspectJ Weaver как Java Agent. В таком проекте он, скорее всего, используется для интеграции с Allure и обработки аспектов, в частности @Step.

                    Второй:
                    -Xmx256m
                    ограничивает максимальный heap для JVM тестов примерно 256 MB.
-->
                    <argLine>
                        -javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectjweaver.version}/aspectjweaver-${aspectjweaver.version}.jar -Xmx256m
                    </argLine>
                   <!-- В твоём случае ему дополнительно передана конфигурация:
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    А ${suiteXmlFile} выше определён как:
                    src/test/resources/regression.xml
                    То есть при:
                    mvn test
                    Surefire использует TestNG suite:
                    regression.xml-->
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

          <!--  allure-testng
            ↓
            собирает результаты тестов для Allure

            allure-maven
            ↓
            помогает Maven сформировать Allure Report-->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.10.0</version>
            </plugin>

        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure-testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!--AspectJ — технология аспектно-ориентированного программирования.
Если сильно упростить, AspectJ позволяет внедрить дополнительное поведение вокруг вызова метода без
 необходимости вручную добавлять этот код внутрь каждого метода.-->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectjweaver.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>6.3.4</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-core -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.1</version>
        </dependency>

        <!--Для считывания yaml-файлов -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.12.3</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>RELEASE</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>